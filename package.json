{
  "name": "blackcat-crm",
  "productName": "黑猫SCRM",
  "version": "1.14.3",
  "description": "黑猫SCRM 多平台聊天与客户管理",
  "main": "main.js",
  "blackcatServer": "https://sky.tail75b558.ts.net",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "local.blackcat-crm",
    "productName": "黑猫SCRM",
    "files": [
      "main.js",
      "preload.js",
      "proxy.js",
      "crx.js",
      "line-shim.js",
      "translate.js",
      "webview-preload.js",
      "assets/**/*",
      "renderer/**/*",
      "ai-service.js",
      "ai-main.js",
      "knowledge-sources.js",
      "media-source.js",
      "knowledge-learning.js",
      "conversation-notes.js",
      "backup-main.js",
      "backup-archive.js",
      "backup-bundle.js",
      "backup-reader.js",
      "backup-delete.js",
      "app-system.js",
      "app-assistant.js",
      "assistant-engine.js",
      "notification-popups.js",
      "popup-preload.js",
      "assistant-actions.js",
      "assistant-labels.js",
      "recipient-address.js",
      "wa-username.js",
      "wa-directory.js",
      "backup-download.js",
      "backup-identities.js",
      "message-alerts.js",
      "backup-account-lifecycle.js",
      "backup-worker.js",
      "desktop-notifications.js",
      "user-guide.js",
      "guide-figures.js",
      "license.js",
      "app-update.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/blackcat.ico"
    },
    "artifactName": "黑猫SCRM.${ext}",
    "nsis": {
      "oneClick": false,
      "guid": "1e4bfb24-9e8a-51ca-9008-7cef46ffba96",
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "黑猫SCRM",
      "deleteAppDataOnUninstall": false,
      "artifactName": "BlackCat-SCRM-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sky.tail75b558.ts.net/updates"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  }
}
