[Unit]
Description=BlackCat SCRM account and AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackcat
Group=blackcat
WorkingDirectory=/opt/blackcat-server/current/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/blackcat-server
Environment=DIST_DIR=/var/lib/blackcat-server/dist
Environment=ADMIN_COOKIE_SECURE=1
EnvironmentFile=-/etc/blackcat-server/claude.env
ExecStart=/opt/blackcat-node/bin/node /opt/blackcat-server/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackcat-server

[Install]
WantedBy=multi-user.target
